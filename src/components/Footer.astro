---
const year = new Date().getFullYear();
---

<footer class="mt-28 border-t border-ink">
  <div class="mx-auto max-w-7xl px-5 py-16 md:px-10">
    <div class="flex flex-col items-center gap-6 text-center">
      <p class="font-display text-5xl uppercase tracking-[0.04em] text-ink md:text-6xl">
        Maki K.
      </p>
      <p class="caption">Wine · Osaka · Est. {year}</p>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-line pt-6 md:flex-row">
      <p class="caption">&copy; {year} Maki K.</p>
      <p class="caption">Drink &amp; Remember</p>
    </div>
  </div>

  <!-- Back to top -->
  <button
    id="pagetop"
    class="font-label pointer-events-none fixed bottom-6 right-6 z-40 flex h-11 items-center justify-center gap-2 border border-ink bg-paper px-4 text-[0.62rem] uppercase tracking-[0.22em] text-ink opacity-0 transition-all duration-300 hover:bg-ink hover:text-paper"
    aria-label="ページトップに戻る"
    title="ページトップに戻る"
  >
    <svg
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 19V5M5 12l7-7 7 7"></path>
    </svg>
    Top
  </button>
</footer>

<script>
  const btn = document.getElementById("pagetop");
  if (btn) {
    const onScroll = () => {
      const visible = window.scrollY > 200;
      btn.style.opacity = visible ? "1" : "0";
      btn.style.pointerEvents = visible ? "auto" : "none";
    };
    btn.addEventListener("click", () =>
      window.scroll({ top: 0, behavior: "smooth" }),
    );
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
