---
import type { Blog } from "../libs/microcms";
import { wineTypeOf } from "../libs/microcms";
import RatingStars from "./RatingStars.astro";
import Badge from "./Badge.astro";

interface Props {
  blog: Blog;
  index: number;
}

const { blog, index } = Astro.props;

const type = wineTypeOf(blog);

const plain = (html?: string) =>
  (html ?? "").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();

const excerpt = plain(blog.title2);
const tags = [blog.region, blog.grape, blog.vintage].filter(Boolean).map(String);

const haystack = [blog.title, excerpt, type, ...tags]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();

const num = String(index + 1).padStart(3, "0");
---

<li
  class="wine-card reveal group"
  style={`--i:${index % 4}`}
  data-type={type ?? ""}
  data-search={haystack}
>
  <a href={`/${blog.id}`} class="flex h-full flex-col">
    <!-- Image -->
    <div class="relative overflow-hidden bg-paper-deep">
      <span
        class="caption absolute left-3 top-3 z-10 text-paper mix-blend-difference"
        >{num}</span
      >
      {type && (
        <span class="absolute right-2.5 top-2.5 z-10">
          <Badge type={type} solid />
        </span>
      )}
      <div class="aspect-[3/4]">
        {
          blog.image?.url ? (
            <img
              src={`${blog.image.url}?w=720&fit=crop`}
              alt={blog.title}
              width={blog.image.width ?? 720}
              height={blog.image.height ?? 960}
              loading="lazy"
              class="h-full w-full object-cover grayscale-[0.15] transition-all duration-[800ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.09] group-hover:grayscale-0"
            />
          ) : (
            <div class="flex h-full items-center justify-center font-display text-2xl italic text-line">
              no image
            </div>
          )
        }
      </div>
    </div>

    <!-- Body -->
    <div class="flex flex-1 flex-col gap-2.5 pt-4">
      <!-- rating -->
      {
        typeof blog.rating === "number" && (
          <div class="flex">
            <RatingStars rating={blog.rating} />
          </div>
        )
      }

      <h3
        class="font-display text-xl leading-[1.08] font-medium text-ink decoration-1 underline-offset-[5px] group-hover:underline sm:text-2xl md:text-[1.6rem] md:leading-[1.05]"
      >
        {blog.title}
      </h3>

      {
        excerpt && (
          <p class="font-serif line-clamp-2 hidden text-sm font-light leading-relaxed text-ink-soft sm:block">
            {excerpt}
          </p>
        )
      }

      {
        tags.length > 0 && (
          <ul class="caption mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-2">
            {tags.map((t) => (
              <li class="before:mr-3 before:text-line before:content-['/'] first:before:hidden">
                {t}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </a>
</li>
