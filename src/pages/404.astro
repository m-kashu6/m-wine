---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — M's Wine Record" description="ページが見つかりませんでした。">
  <section
    class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center gap-6 px-5 py-24 text-center md:px-10"
  >
    <p class="eyebrow text-accent">Error 404</p>
    <h1 class="font-display text-[clamp(4rem,18vw,9rem)] font-medium leading-[0.85] text-ink">
      404
    </h1>
    <p class="font-serif max-w-md text-ink/85">
      お探しのページは見つかりませんでした。グラスは空のようです。
    </p>
    <a
      href="/"
      class="font-label group mt-2 inline-flex items-center gap-3 border border-ink px-8 py-4 text-xs uppercase tracking-[0.24em] text-ink transition-colors hover:bg-ink hover:text-paper"
    >
      <span class="transition-transform duration-300 group-hover:-translate-x-1" aria-hidden="true">&larr;</span>
      Back to Index
    </a>
  </section>
</Layout>
